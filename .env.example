# Clerk (auth + team workspaces). `npx clerk init` or dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Enables Claude synthesis. Without it, Cairn runs in extractive mode (verbatim passages only).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# CAIRN_MODEL=claude-opus-5
