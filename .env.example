# Clerk (auth + team workspaces). `npx clerk init` or dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Neon Postgres (Vercel → Storage → Neon). All workspaces, documents and research live here.
DATABASE_URL=

# Vercel Blob, private store (Vercel → Storage → Blob). Only used as a temporary drop-off
# for uploads over ~3.5 MB; files are parsed then deleted. Optional for local dev.
BLOB_READ_WRITE_TOKEN=

# Enables Claude synthesis. Without it, Cairn runs in extractive mode (verbatim passages only).
ANTHROPIC_API_KEY=
# Max Claude research runs per workspace per day (default 25)
# CAIRN_DAILY_RUNS=25
# Optional model override (default: claude-opus-5)
# CAIRN_MODEL=claude-opus-5
